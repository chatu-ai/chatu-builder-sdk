{
  "name": "@chatu-ai/app-sdk",
  "version": "0.9.2",
  "description": "Runtime SDK for apps generated by ChatU Builder: kv, db, storage, auth (app users) and ai (OpenAI-compatible LLM relay) with platform / byo / edgeone / memory drivers selected by environment variables",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatu-ai/chatu-builder-sdk.git",
    "directory": "packages/app-sdk"
  },
  "homepage": "https://github.com/chatu-ai/chatu-builder-sdk/tree/main/packages/app-sdk#readme",
  "bugs": "https://github.com/chatu-ai/chatu-builder-sdk/issues",
  "keywords": [
    "chatu",
    "builder",
    "kv",
    "storage",
    "app-sdk",
    "auth",
    "ai",
    "llm",
    "nextjs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "ioredis": ">=5",
    "@aws-sdk/client-s3": ">=3",
    "@aws-sdk/s3-request-presigner": ">=3"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    }
  }
}
